NODE_ENV=production
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5
GEMINI_API_KEY=
AI_PROVIDER=local
GEMINI_ENDPOINT=https://generativelanguage.googleapis.com/v1beta/models/gemini-2.0-flash:generateContent
JWT_SECRET=replace_with_64_plus_character_random_secret
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_EXPIRES_DAYS=30
LOGIN_RATE_LIMIT_PER_MIN=12
OTP_RATE_LIMIT_PER_MIN=8
IDEMPOTENCY_TTL_MINUTES=15
PORT=8080
DB_PROVIDER=postgres
DATABASE_URL=postgres://user:password@host:5432/sehatsaathi
FILE_STORAGE_MODE=local_persistent
PUBLIC_UPLOAD_BASE_URL=https://api.yourdomain.com/uploads
# ── Support contact (shown to users in-app) ──────────────────
# SUPPORT_WHATSAPP is the most important one for Indian pilot users.
# Format: country code + number, no spaces. E.g. 919876543210
# This appears in the in-app "Help" sheet as a WhatsApp direct link.
SUPPORT_EMAIL=support@sehatsaathi.health
SUPPORT_PHONE=+91XXXXXXXXXX
SUPPORT_WHATSAPP=91XXXXXXXXXX
PASSWORD_RESET_BASE_URL=https://app.yourdomain.com/reset-password
CORS_ORIGINS=https://app.yourdomain.com,https://ops.yourdomain.com
DB_PATH=./database/health.db
UPLOAD_DIR=/data/uploads
BACKUP_DIR=/data/backups
BACKUP_RETENTION_DAYS=14
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_AUTH=
ALERT_COOLDOWN_SECONDS=120
UPTIME_HEARTBEAT_SECONDS=60
OTP_DELIVERY_WEBHOOK_URL=
OTP_DELIVERY_WEBHOOK_AUTH=
RESEND_API_KEY=
RESEND_FROM_EMAIL=no-reply@yourdomain.com
OTP_LENGTH=6
OTP_EXPIRES_MINUTES=10
PASSWORD_RESET_OTP_OUTBOX_PATH=/data/outbox/password_reset_otp_requests.log
TRIAGE_MODEL_ENABLED=false
TRIAGE_MODEL_PYTHON=python3
TRIAGE_MODEL_SCRIPT=./backend/ml/predict_triage.py
TRIAGE_MODEL_FILE=./backend/ml/artifacts/triage_model.joblib
TRIAGE_MODEL_META_FILE=./backend/ml/artifacts/model_metadata.json

# ── ABDM / ABHA integration ─────────────────────────────────
# Keep disabled until the ABDM sandbox portal issues credentials and the
# exact API paths approved for your integration milestone.
ABDM_ENABLED=false
ABDM_BASE_URL=
ABDM_CLIENT_ID=
ABDM_CLIENT_SECRET=
ABDM_SESSION_PATH=
ABDM_ABHA_VERIFY_URL=
ABDM_ABHA_PROFILE_URL=
ABDM_TIMEOUT_MS=10000
